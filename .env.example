# Copy to env or .env. Keep real credentials out of Git.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Required for temporary AWS credentials; leave empty for long-term keys.
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
# Alternatively, leave keys empty and select an existing AWS CLI/SSO profile.
# AWS_PROFILE=default
# Set to an inference profile ID authorized in your AWS account/region.
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
AAVE_PROJECT_ROOT=.
